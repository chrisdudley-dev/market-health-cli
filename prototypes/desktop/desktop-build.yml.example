name: Build desktop application
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  package:
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - run: python -m pip install -e ".[desktop,build]"
      - run: python -m market_health.desktop.build
      - uses: actions/upload-artifact@v4
        with:
          name: MarketHealth-${{ matrix.os }}
          path: dist/MarketHealth/
